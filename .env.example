# ==========================================
# VerdAI / Verdix Disease Detection Settings
# ==========================================

# Google Gemini API Key
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Path to custom ML / Deep Learning model weights (.pth, .pt, .onnx, .h5, .keras, .tflite)
# Leave blank to use Gemini Vision analysis or auto-detect from weights/ directory
MODEL_WEIGHTS_PATH=

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
